# Olive Hub — configuration template
# Copy the keys you need into `.env`. Never commit real secrets.
# The hub also reads the keys your existing project already uses
# (GROQ_API_KEY, GROQ_BASE_URL, AI_PROVIDER, OLLAMA_BASE_URL,
#  HOME_ASSISTANT_URL, HOME_ASSISTANT_TOKEN, WEATHER_LAT, WEATHER_LON).

# ---- LibreEcho speaker ------------------------------------------------
SPEAKER_URL=http://192.168.1.228:8080/api/v1
SPEAKER_USER=olive
SPEAKER_PASSWORD=change-me

# ---- WhatsApp bridge (local whatsapp-web.js service) ------------------
# Start with .\start-whatsapp-bridge.ps1; scan qr.png once with WhatsApp.
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3011
WHATSAPP_BRIDGE_TOKEN=

# ---- Hub HTTP endpoint (OpenAI-compatible) ----------------------------
HUB_HOST=127.0.0.1
# 8765 is the port the LibreEcho agent is pointed at. Windows Firewall already
# allows inbound 8765 to the LAN; 8766 has no allow rule on this machine.
HUB_PORT=8765
# When set, every request except /health must send X-Olive-Token: <value>
HUB_TOKEN=

# ---- Wyoming ASR proxy ------------------------------------------------
ASR_HOST=127.0.0.1
# The speaker's STT target, e.g. tcp://192.168.1.228:10300
ASR_PORT=10300
# The hub forwards audio to the local Whisper Wyoming server (10301),
# started by start-whisper-detached.ps1 / the Olive Hub watchdog.
WHISPER_HOST=127.0.0.1
WHISPER_PORT=10301
# WHISPER_MODEL=base          # model cached in ~/.cache/whisper
# WHISPER_LANGUAGE=en         # empty = auto-detect
# WHISPER_TIMEOUT=30
ASR_TIMEOUT=15

# ---- LLM passthrough (optional) ---------------------------------------
# Leave empty to auto-use Groq (AI_PROVIDER=groq + GROQ_API_KEY),
# otherwise Ollama (OLLAMA_BASE_URL), otherwise OpenAI.
LLM_URL=
LLM_TOKEN=
LLM_TIMEOUT=30

# ---- Radio ------------------------------------------------------------
# Allow radio-browser.info lookups for genres/moods that are not in the
# curated catalog (e.g. "play reggae", "play drum and bass").
RADIO_SEARCH=1
# Named stations ("play bbc one extra") go through Music Assistant when
# MA is configured. Set to 0 to keep the speaker's own radio player first.
RADIO_PREFER_MA=1

# ---- Tuya (optional, direct — no Home Assistant needed) ---------------
# Get these from https://iot.tuya.com -> Cloud -> Development, then run:
#   .\.venv\Scripts\python.exe tuya_setup.py --write
TUYA_REGION=eu
TUYA_API_KEY=
TUYA_API_SECRET=
# Only for a "central control" device; usually empty.
TUYA_DEVICE_ID=

# ---- Local IoT (no cloud, no Tuya project) ----------------------------
# Tuya Wi-Fi lights answer locally on port 6668 but need a 16-char local key.
# Run iot_scan.py, then copy iot_keys.example.json -> iot_keys.json and paste
# each key. Entries without a key are ignored.
IOT_ENABLED=1
# Empty = iot_keys.json next to the hub.
IOT_KEYS_FILE=

# ---- Home Assistant (optional) ----------------------------------------
# HOME_ASSISTANT_URL / HOME_ASSISTANT_TOKEN also work.
# When HA and Tuya are both configured, HA is tried first.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
HA_TIMEOUT=5

# ---- Behaviour --------------------------------------------------------
OLIVE_CITY=San Vincenzo
WEATHER_LAT=43.09
WEATHER_LON=10.54
OLIVE_UNITS=metric
OLIVE_LANGUAGE=en

# Music ducking while announcing:
#   auto   -> lower the volume (live radio cannot pause)
#   pause  -> same as auto on this firmware
#   volume -> lower volume only (best for live radio)
#   none   -> leave audio alone
DUCK_MUSIC=1
DUCK_MODE=auto

# Keep the pipeline silent when the device already spoke the answer.
SUPPRESS_TTS_ON_DEVICE=1

# SSE for the speaker's agent (1) or plain JSON (0).
STREAM_CHAT=1

# ---- Conversation ------------------------------------------------------
# How long a voice thread is remembered (seconds).
CONVERSATION_TTL=120
# Reopen the microphone after a spoken reply so the user can answer without
# the wake word. The window opens after the announcement has finished.
FOLLOW_UP=1
FOLLOW_UP_DELAY=2.5
# How long a "How long should the timer be?" question waits for an answer.
PENDING_TTL=60

# ---- Permanent memory --------------------------------------------------
# Facts, notes and recent topics survive restarts and feed the LLM prompt.
MEMORY=1
# Where they live (empty = olive_memory.json next to the hub).
OLIVE_MEMORY_FILE=

# ---- LED feedback (device profiles) ------------------------------------
LED_THEME=1
LED_BRIGHTNESS=100
# conversation / listening: yellow on the left and right
LED_LISTENING_RGB=255,190,0
# cloud AI thinking: slow flashing orange at the back
LED_THINKING_RGB=255,96,0

# ---- News / calendar / Telegram (optional) -----------------------------
NEWS_ENABLED=1
# ICS calendar: a URL (webcal/https) or a local file.
CALENDAR_ICS_URL=
CALENDAR_ICS_FILE=calendar.ics
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Personal facts / mood music ---------------------------------------
# Where "remember my birthday is ..." and cached mood stations are stored.
PERSONAL_FACTS_FILE=personal_facts.json
MUSIC_CATALOG_FILE=music_catalog.json

# ---- TV: Chromecast + Android TV ---------------------------------------
TV_ENABLED=1
# Fuzzy cast name, e.g. "living room". Empty = first discovered device.
TV_CAST_NAME=
TV_DISCOVERY_TIMEOUT=8
TV_CACHE_SECONDS=60
# ADB for power/apps. Empty host = use the cast device's IP.
TV_ADB_HOST=
TV_ADB_PORT=5555
# Empty = "adb" on PATH, then platform-tools\adb.exe next to the hub.
ADB_PATH=

# ---- Music Assistant (optional; off by default) ------------------------
# Device-native radio is the primary player. Music Assistant is used when you
# say "on music assistant" / "everywhere", with an automatic native fallback
# when the speaker's Sendspin client does not start streaming.
MA_ENABLED=1
MA_URL=
MA_TOKEN=
MA_PLAYER_ID=

# ---- Local dashboard (127.0.0.1:DASH_PORT) -----------------------------
DASH_PORT=8767
# WSL Kokoro Wyoming endpoint (Tailscale IP when WSL localhost forwarding is off)
KOKORO_HOST=127.0.0.1
KOKORO_PORT=10222
